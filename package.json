{
  "name": "mktechmonk-ai-trading",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "node scripts/local.mjs dev",
    "build": "node scripts/local.mjs build",
    "typecheck": "turbo typecheck",
    "lint": "eslint apps packages --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "setup": "bash scripts/setup-local.sh",
    "seed": "tsx scripts/demo.ts",
    "demo": "tsx scripts/demo.ts",
    "replay:market": "tsx scripts/demo.ts",
    "backup:local": "node scripts/database-tools.mjs backup",
    "restore:local": "node scripts/database-tools.mjs restore",
    "test:api": "tsx scripts/check-api.ts",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json}\" \"packages/**/*.{ts,json}\" \"scripts/*.ts\"",
    "start": "node scripts/local.mjs start",
    "setup:local": "bash scripts/setup-local.sh",
    "db:migrate": "pnpm --filter @mk/api exec tsx src/bootstrap-local.ts",
    "test:db": "pnpm --filter @mk/api exec tsx src/check-persistence.ts",
    "status:local": "node scripts/status-local.mjs",
    "test:analytics": "cd apps/analytics && .venv/bin/python -m pytest && .venv/bin/ruff check analytics tests",
    "test:market": "tsx scripts/check-market.ts",
    "test:research": "pnpm --filter @mk/api exec tsx src/check-news-risk.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.6",
    "eslint": "^9.35.0",
    "prettier": "^3.9.7",
    "tsx": "^4.20.5",
    "turbo": "^2.5.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "zod": "^4.1.8"
  }
}
