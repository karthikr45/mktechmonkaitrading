# MKTechMonk local configuration
# Maintain real values in the ignored .env file; never commit credentials.
# This template covers configuration currently used by the application and tools.
# Optional overrides are commented out so built-in defaults remain active.

# Native PostgreSQL (no Docker required)
# Use the dedicated non-superuser application role. URL-encode password characters.
DATABASE_URL=postgresql://mktechmonk_app:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/mktechmonkai_local
# Optional administrator connection for setup, migrations, backup and restore.
# Default: current OS username, localhost:5432, database postgres.
# Read from .env or the shell. Must use the same host/port as DATABASE_URL.
# Migrations target the database named in DATABASE_URL and never edit .env.
# Existing role passwords are never reset.
# export PG_ADMIN_URL='postgresql://YOUR_ADMIN_USER:YOUR_ADMIN_PASSWORD@127.0.0.1:5432/postgres'
# PG_ADMIN_URL=postgresql://YOUR_ADMIN_USER:YOUR_ADMIN_PASSWORD@127.0.0.1:5432/postgres

# Execution settings: the current implementation supports paper execution only.
EXECUTION_MODE=paper
LIVE_TRADING_ENABLED=false
DEFAULT_TIMEZONE=Asia/Kolkata

# Local service ports used by pnpm dev/start and status:local.
WEB_PORT=3200
API_PORT=4200
ANALYTICS_PORT=8200

# Upstox V3 market data
# Optional: supply a valid token here and restart the API, or enter it in the UI.
# Empty means no environment token; a broker connection must be requested in the UI.
UPSTOX_ACCESS_TOKEN=

# AI configuration schema accepts disabled, mock or ollama.
# Set ollama to enable local evidence-linked news research. mock does not generate research.
AI_PROVIDER=disabled
# Local Ollama service and an already-installed model; no automatic downloads.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Publisher RSS defaults; comma-separated URLs, maximum five.
# Set to an empty value to disable RSS. Only supported NSE/BSE/Moneycontrol hosts.
NEWS_RSS_URLS=https://nsearchives.nseindia.com/content/RSS/Online_announcements.xml,https://www.moneycontrol.com/rss/business.xml

# Advanced overrides for independently launched services.
# pnpm dev/start derive PORT, API_URL and WEB_ORIGIN from the service ports above.
# PORT overrides API_PORT when the API is started independently.
# PORT=4200
# API_URL=http://127.0.0.1:4200
# WEB_ORIGIN=http://127.0.0.1:3200
# Next.js output directory; tests use .next-test to isolate their build.
# NEXT_DIST_DIR=.next
# pnpm dev/start force file-watcher polling for the local web service.
# WATCHPACK_POLLING=true

# Test script overrides: export in your shell when invoking these scripts.
# test:api uses API_URL above; test:market uses this URL including the trailing slash.
# MARKET_TEST_URL=http://127.0.0.1:3200/api/

# database-tools.mjs derives PGHOST, PGPORT, PGUSER and PGPASSWORD from PG_ADMIN_URL
# for its pg_dump/pg_restore subprocesses. Do not configure these separately here.
